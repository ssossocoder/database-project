// 발표용 핵심 업무 관계. 15개 테이블 중 9개와 해당 업무 FK만 표시한다.
// 전체 PK/FK는 proposal-erd.dot와 proposal.md를 참조한다.
digraph core_relationships {
  graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.55", ranksep="0.8",
         fontname="Arial", fontsize=16, labelloc=t,
         label="청약 의사결정 노트 · 핵심 업무 관계\n공고–주택형 1:N / 회원–공고 N:M / 비교–거래 N:M"];
  node [shape=plain, fontname="Arial", fontsize=12];
  edge [fontname="Arial", fontsize=10, color="#64748B", arrowhead=none,
        labeldistance=1.7, labelangle=25];
  announcement [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4F75A8">
    <TR><TD BGCOLOR="#E8F0FC"><B>announcement · 공고</B></TD></TR><TR><TD ALIGN="LEFT">PK  id</TD></TR>
  </TABLE>>];
  unit_type [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4F75A8">
    <TR><TD BGCOLOR="#E8F0FC"><B>unit_type · 주택형</B></TD></TR><TR><TD ALIGN="LEFT">PK  id</TD></TR>
    <TR><TD ALIGN="LEFT">FK  announcement_id</TD></TR>
  </TABLE>>];
  allocation [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4F75A8">
    <TR><TD BGCOLOR="#E8F0FC"><B>allocation · 공급 물량</B></TD></TR><TR><TD ALIGN="LEFT">PK  id</TD></TR>
    <TR><TD ALIGN="LEFT">FK  unit_type_id</TD></TR>
  </TABLE>>];
  app_user [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#687CAD">
    <TR><TD BGCOLOR="#EEF0FC"><B>app_user · 회원</B></TD></TR><TR><TD ALIGN="LEFT">PK  id</TD></TR>
  </TABLE>>];
  watchlist [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#687CAD">
    <TR><TD BGCOLOR="#EEF0FC"><B>watchlist · 관심 공고</B></TD></TR><TR><TD ALIGN="LEFT">PK  id</TD></TR>
    <TR><TD ALIGN="LEFT">FK  app_user_id</TD></TR><TR><TD ALIGN="LEFT">FK  announcement_id</TD></TR>
  </TABLE>>];
  user_note [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#687CAD">
    <TR><TD BGCOLOR="#EEF0FC"><B>user_note · 개인 노트</B></TD></TR><TR><TD ALIGN="LEFT">PK  id</TD></TR>
    <TR><TD ALIGN="LEFT">FK  watchlist_id</TD></TR>
  </TABLE>>];
  comparison_set [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#AE8A4C">
    <TR><TD BGCOLOR="#FFF3DB"><B>comparison_set · 비교 1회</B></TD></TR><TR><TD ALIGN="LEFT">PK  id</TD></TR>
    <TR><TD ALIGN="LEFT">FK  app_user_id</TD></TR><TR><TD ALIGN="LEFT">FK  unit_type_id</TD></TR>
  </TABLE>>];
  comparison_trade [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#AE8A4C">
    <TR><TD BGCOLOR="#FFF3DB"><B>comparison_trade · 포함 거래</B></TD></TR>
    <TR><TD ALIGN="LEFT">PK/FK  comparison_set_id</TD></TR><TR><TD ALIGN="LEFT">PK/FK  apartment_trade_id</TD></TR>
  </TABLE>>];
  apartment_trade [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#418B80">
    <TR><TD BGCOLOR="#E7F5F0"><B>apartment_trade · 매매 거래</B></TD></TR><TR><TD ALIGN="LEFT">PK  id</TD></TR>
  </TABLE>>];
  {rank=same; announcement; app_user; apartment_trade;}
  {rank=same; unit_type; watchlist;}
  {rank=same; allocation; comparison_set; user_note;}
  announcement -> unit_type [taillabel="1", headlabel="0..N"];
  unit_type -> allocation [taillabel="1", headlabel="0..N"];
  app_user -> watchlist [taillabel="1", headlabel="0..N", color="#687CAD"];
  announcement -> watchlist [taillabel="1", headlabel="0..N", color="#687CAD"];
  watchlist -> user_note [taillabel="1", headlabel="0..N", color="#687CAD"];
  app_user -> comparison_set [taillabel="1", headlabel="0..N"];
  unit_type -> comparison_set [taillabel="1", headlabel="0..N"];
  comparison_set -> comparison_trade [taillabel="1", headlabel="0..N", color="#AD8040", penwidth=1.6];
  apartment_trade -> comparison_trade [taillabel="1", headlabel="0..N", color="#AD8040", penwidth=1.6];
}
